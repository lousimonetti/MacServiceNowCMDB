# ============================================================================
# intune-cmdb-sync configuration
#
# Copy to .env, fill in, and never commit it. Every value here is also settable
# as a plain environment variable, which is how the Azure and AWS deployments
# supply them.
#
# Only the values marked REQUIRED must be set. Everything else has a default
# that is safe for a first run.
# ============================================================================

# ---------------------------------------------------------------------------
# Microsoft Graph / Entra ID
# ---------------------------------------------------------------------------

# REQUIRED. Your Entra tenant ID (GUID).
GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000

# How to authenticate to Graph:
#   client_secret      app registration + secret. Works anywhere, and the only
#                      option when Intune lives in a different tenant from the
#                      host. This is what deploy/azure/main.bicep configures.
#                      (default)
#   managed_identity   Azure only, and the best option there: no secret exists
#                      at all. A managed identity is single-tenant, so this
#                      requires Intune in the SAME tenant as the deployment;
#                      deploy.sh refuses it otherwise.
#   federated_managed_identity
#                      Secretless AND cross-tenant. A managed identity in the
#                      hosting tenant signs a client assertion for a
#                      multi-tenant app consented into the Intune tenant. The
#                      only option that is both. See docs/entra-setup.md.
#   workload_identity  federated token file (AKS, GitHub Actions OIDC). Not
#                      Container Apps, which projects no such file.
#   default            DefaultAzureCredential — handy for local development.
#   access_token       LOCAL DEVELOPMENT ONLY. Paste a Graph bearer token
#                      directly, for testing against a tenant where you cannot
#                      create an app registration. No refresh: when the token
#                      expires (typically an hour) the run fails. Rejected by
#                      the Azure deployment on purpose.
GRAPH_AUTH_MODE=client_secret

# REQUIRED for client_secret. For managed_identity, set this to the client ID of
# the user-assigned identity (omit it to use the system-assigned one).
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000

# REQUIRED for client_secret. Can instead come from GRAPH_CLIENT_SECRET_FILE
# (a mounted file) or GRAPH_CLIENT_SECRET_PARAMETER (an AWS SSM parameter name).
GRAPH_CLIENT_SECRET=

# REQUIRED for federated_managed_identity: the client ID of the managed identity
# that signs the assertion. This is NOT GRAPH_CLIENT_ID, which is the app
# registration. Omit to use the system-assigned identity.
# GRAPH_ASSERTION_IDENTITY_CLIENT_ID=

# REQUIRED for access_token. Also readable from GRAPH_ACCESS_TOKEN_FILE.
#
# Get one from Graph Explorer (https://developer.microsoft.com/graph/graph-explorer),
# signing in and consenting DeviceManagementManagedDevices.Read.All.
#
# `az account get-access-token` does NOT work here: that mints a token for the
# Azure CLI's own app registration, which holds no Intune permissions, so the
# device call returns 403. The connector inspects the token and says so before
# the request rather than letting you discover it from the error.
# GRAPH_ACCESS_TOKEN=

# Sovereign clouds: set both. Defaults shown are the commercial cloud.
#   US Gov  https://graph.microsoft.us/v1.0        + https://login.microsoftonline.us
#   China   https://microsoftgraph.chinacloudapi.cn/v1.0 + https://login.chinacloudapi.cn
# GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
# AZURE_AUTHORITY_HOST=https://login.microsoftonline.com

# Devices per Graph page. Lower it if you hit throttling on a very large tenant.
GRAPH_PAGE_SIZE=200

# ---------------------------------------------------------------------------
# Which devices to sync
# ---------------------------------------------------------------------------

# company | personal | any. The whole point of this connector is `company`:
# personally-owned devices are filtered out client-side even if the server-side
# filter is ignored, so BYOD hardware can never reach the CMDB.
INTUNE_OWNERSHIP=company

# Push the ownership filter into the Graph query. Graph does not formally
# document managedDeviceOwnerType as filterable, so the connector falls back to
# an unfiltered fetch if the query is rejected. Set false to skip the attempt.
INTUNE_SERVER_SIDE_FILTER=true

# Fetch RAM, ethernet MAC, and UDID. Graph returns these as null from the device
# *collection* endpoint, so enabling this costs one extra Graph call per device.
# Leave it off unless the CMDB actually needs those fields.
INTUNE_FETCH_HARDWARE_DETAIL=false

# Process at most this many devices. 0 or unset means no limit. A testing aid
# for a first run against a real instance -- it keeps the write small enough to
# check by hand. Retirement is skipped whenever a limit is set, because a
# truncated device list makes the rest of the fleet look like it disappeared.
# Also settable per-run with --limit N.
# INTUNE_DEVICE_LIMIT=

# ---------------------------------------------------------------------------
# ServiceNow connection
# ---------------------------------------------------------------------------

# REQUIRED. Accepts 'acme', 'acme.service-now.com', or a full https URL.
SNOW_INSTANCE=acme

# oauth_client_credentials  Washington DC and later. No user password anywhere.
# oauth_password            resource-owner password grant, for older instances.
# basic                     HTTP Basic. Simplest, least desirable.
SNOW_AUTH_MODE=oauth_client_credentials

# REQUIRED for both OAuth modes.
SNOW_CLIENT_ID=
SNOW_CLIENT_SECRET=

# Only for oauth_password and basic.
# SNOW_USERNAME=
# SNOW_PASSWORD=

# ---------------------------------------------------------------------------
# How CIs are written
# ---------------------------------------------------------------------------

# identify_reconcile  POST /api/now/identifyreconcile. Bulk, and the only mode
#                     that can key CIs on the Intune device ID via
#                     sys_object_source_info. Recommended. (default)
# cmdb_instance       POST /api/now/cmdb/instance/{class}. One call per CI, and
#                     identification falls back to serial number / name.
SNOW_WRITE_MODE=identify_reconcile

# Must exactly match a choice value on cmdb_ci.discovery_source. The included
# ServiceNow app registers this; see servicenow-app/ or docs/servicenow-setup.md.
SNOW_DISCOVERY_SOURCE=Intune
SNOW_SOURCE_FEED=Intune Managed Devices

# CIs per identifyreconcile request, and parallel requests in cmdb_instance mode.
SNOW_BATCH_SIZE=100
SNOW_CONCURRENCY=4

# Intune operatingSystem -> ServiceNow CMDB class. An OS that appears in neither
# this map nor SNOW_DEFAULT_CLASS is skipped and reported, never guessed at.
SNOW_CLASS_MAP=windows=cmdb_ci_computer;macos=cmdb_ci_computer
# Uncomment to also bring in mobile hardware, once you have confirmed the class
# name exists in your instance:
# SNOW_CLASS_MAP=windows=cmdb_ci_computer;macos=cmdb_ci_computer;ios=cmdb_ci_computer;android=cmdb_ci_computer
# SNOW_DEFAULT_CLASS=cmdb_ci_computer

# Write the Intune managedDevice id to this field so CIs stay traceable to their
# source from inside ServiceNow. Set SNOW_SET_CORRELATION=false if another
# integration already owns correlation_id.
SNOW_CORRELATION_FIELD=correlation_id
SNOW_SET_CORRELATION=true

# Set install_status on every synced CI. Leave unset to let ServiceNow keep
# whatever value the CI already has. VERIFY the numeric value in your instance
# before enabling: the choice list is customisable and 1 is only the usual
# value for "Installed".
# SNOW_INSTALL_STATUS_ACTIVE=1

# Extra static attributes applied to every CI, as JSON. Reference fields need a
# sys_id, not a display name.
# SNOW_EXTRA_ATTRIBUTES={"company":"<core_company sys_id>","u_managed_by_team":"EUC"}

# Field-level overrides beyond the built-in mapping.
# MAPPING_OVERRIDES_FILE=/etc/intune-cmdb-sync/mapping-overrides.json

# ---------------------------------------------------------------------------
# Device owner -> sys_user
# ---------------------------------------------------------------------------

SNOW_ASSIGN_USER=true

# Tried in order; the first unambiguous hit wins. A key that matches more than
# one sys_user is treated as no match, because assigning a laptop to the wrong
# person is worse than leaving assigned_to empty.
#   employee_number  sys_user.employee_number == Entra employeeId  (most stable)
#   email            sys_user.email           == Entra mail / UPN
#   user_name        sys_user.user_name       == UPN, then its local part
#   entra_id         a custom field holding the Entra object ID   (most stable
#                    of all, if you populate it)
SNOW_USER_MATCH_ORDER=employee_number,email,user_name
# SNOW_USER_MATCH_ORDER=entra_id,employee_number,email
# SNOW_USER_ENTRA_ID_FIELD=u_entra_object_id

# Only match active sys_user records.
SNOW_USER_ACTIVE_ONLY=true

# Look up each owner in Entra for employeeId/department/etc. Requires the
# User.Read.All application permission. With this off, the connector uses only
# the UPN and email already present on the Intune device record, and
# employee_number matching cannot work.
GRAPH_ENRICH_USERS=true

# ---------------------------------------------------------------------------
# Manufacturer and model references
# ---------------------------------------------------------------------------

# manufacturer -> core_company and model_id -> cmdb_model are reference fields:
# they need a sys_id, and IRE will not resolve a display name for you. Names
# that match nothing are left empty and listed in the run report.
# Turn these on only if you want the connector adding rows to those catalogues.
SNOW_CREATE_MISSING_MANUFACTURERS=false
SNOW_CREATE_MISSING_MODELS=false

# ---------------------------------------------------------------------------
# Retirement
# ---------------------------------------------------------------------------

# Retire CIs for devices that have disappeared from Intune. Requires STATE_PATH.
SNOW_RETIRE_MISSING=false

# install_status value meaning "retired". VERIFY this against your instance.
SNOW_RETIRE_INSTALL_STATUS=7

# Safety valve. If more than this fraction of known devices are missing in one
# run, retirement is skipped and the run is flagged. A partial Graph outage
# looks exactly like a fleet that vanished overnight; this is what stops the
# connector acting on that.
SNOW_RETIRE_MAX_FRACTION=0.10

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# Read everything, run IRE identification, write nothing.
DRY_RUN=false

LOG_LEVEL=INFO
LOG_FORMAT=json

# Where the Intune-id -> CI-sys_id map lives. A local path, or an s3:// URL when
# running on AWS Lambda. Required for retirement; otherwise optional.
# STATE_PATH=/var/lib/intune-cmdb-sync/state.json
# STATE_PATH=s3://my-bucket/intune-cmdb-sync/state.json

# Machine-readable run summary.
# RUN_REPORT_PATH=/var/log/intune-cmdb-sync/run-report.json

# Extra junk serial numbers to reject, on top of the built-in list.
# SERIAL_BLOCKLIST_EXTRA=Default string,Not Specified

# ---------------------------------------------------------------------------
# Advanced — defaults are fine unless you have a specific reason
# ---------------------------------------------------------------------------

# Graph token scope. Change only for a sovereign cloud, where it must match
# GRAPH_BASE_URL's host (e.g. https://graph.microsoft.us/.default).
# GRAPH_SCOPE=https://graph.microsoft.com/.default

# Entra user properties fetched during owner enrichment. Trimming this list
# shrinks the $batch response; removing `employeeId` disables employee_number
# matching, and removing `mail` weakens email matching.
# GRAPH_USER_SELECT_FIELDS=id,userPrincipalName,mail,displayName,employeeId,department,companyName,officeLocation,city,country,accountEnabled

# Per-request timeouts and retry budgets. Retries honour the server's
# Retry-After header first and fall back to exponential backoff with jitter, so
# raising these makes the connector wait longer rather than hammer harder.
# GRAPH_TIMEOUT_SECONDS=60
# GRAPH_MAX_RETRIES=5
# SNOW_TIMEOUT_SECONDS=60
# SNOW_MAX_RETRIES=5

# Use POST /api/now/identifyreconcile/enhanced instead of the standard endpoint.
# Enhanced mode accepts partial payloads: an item that fails identification is
# parked in cmdb_ire_partial_payloads rather than failing outright. That is more
# forgiving, but it moves failures out of the run report and into a table
# someone has to remember to check — which is why it is off by default.
# SNOW_USE_ENHANCED_IRE=false
# SNOW_ENHANCED_IRE_OPTIONS=partial_payloads:true,generate_summary:true

# Standard Azure SDK variables, accepted as fallbacks for their GRAPH_*
# equivalents so DefaultAzureCredential setups work unchanged. GRAPH_* wins.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_CLIENT_CERTIFICATE_PATH=   # certificate auth with GRAPH_AUTH_MODE=default
